{
  "name": "smartondev/httpcache",
  "description": "Simple HTTP cache management library",
  "type": "library",
  "license": "Apache-2.0",
  "keywords": [
    "http",
    "cache",
    "caching",
    "http-cache",
    "etag",
    "cache-control",
    "last-modified",
    "http-headers"
  ],
  "homepage": "https://github.com/smartondev/httpcache",
  "support": {
    "issues": "https://github.com/smartondev/httpcache/issues",
    "source": "https://github.com/smartondev/httpcache"
  },
  "authors": [
    {
      "name": "Márton Somogyi",
      "email": "kamarton@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "pestphp/pest": "^3.7",
    "mockery/mockery": "^1.6"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "SmartonDev\\HttpCache\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SmartonDev\\HttpCache\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "pest",
    "test:coverage": "pest --coverage",
    "analyse": "phpstan analyse src --level=max"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "platform": {
      "php": "8.2.0"
    }
  }
}
